# ============================================================
# LabShare – Environment Variables
# Copy to .env and fill in production values
# ============================================================

# ── Node ─────────────────────────────────────────────────
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=labshare
POSTGRES_PASSWORD=labshare_dev
POSTGRES_DB=labshare
POSTGRES_PORT=5432
DATABASE_URL=postgresql://labshare:labshare_dev@localhost:5432/labshare

# ── Redis ─────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── MinIO / S3 ────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=labshare_minio
MINIO_SECRET_KEY=labshare_minio_secret
MINIO_BUCKET=labshare
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
# For production S3:
# S3_ENDPOINT=https://s3.amazonaws.com
# AWS_REGION=ap-south-1

# ── JWT ───────────────────────────────────────────────────
# CHANGE THESE IN PRODUCTION (min 32 chars, random)
JWT_SECRET=dev_jwt_secret_change_in_prod_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_prod_32c
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── OTP ───────────────────────────────────────────────────
# OTP_PROVIDER: mock | sms (MSG91) | whatsapp
OTP_PROVIDER=mock
# MSG91_AUTH_KEY=your_msg91_key
# MSG91_TEMPLATE_ID=your_template_id

# ── Ports ─────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000

# ── Frontend & Maps ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Google Maps Integration:
# Works out-of-the-box everywhere without a key using intelligent geocoding & embed fallback!
# Set your Google Maps API key here if you want official Google Maps JS API tiles:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_STYLE=https://tiles.stadiamaps.com/styles/alidade_smooth.json
# For Mapbox (optional, not required – OpenStreetMap used by default):
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ij...

# ── Demo Mode ─────────────────────────────────────────────
# When true: shows demo accounts on login, uses demo OTP 123456
DEMO_MODE=true

# ── App ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=100
